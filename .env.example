# Copy to .env (never commit .env). scripts/dev.* creates it for you and fills the
# secrets marked "generated" on first run. Real environment variables override .env.

# --- PostgreSQL (shared by docker-compose and the API) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=signalchat
POSTGRES_USER=signalchat
# generated
POSTGRES_PASSWORD=change-me

# --- Personal data encryption (AES-256-GCM, base64 of 32 random bytes) ---
# generated. Changing or losing it makes stored emails unreadable: back it up, never commit it.
PII_ENCRYPTION_KEY=

# --- Google sign-in (see README "Google sign-in") ---
# Without these the app runs, but /auth/login answers 503.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Frontend / CORS (explicit allowlist, comma-separated, no "*") ---
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- E2E test sign-in (off by default; allowed only in Testing or E2E, never in Production) ---
# E2E_TEST_AUTH=true
