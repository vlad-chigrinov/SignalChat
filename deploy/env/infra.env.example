# Copy to infra.env on the server (chmod 600) and fill it in. The real file is never committed.
# Used by docker-compose.infra.yml:  docker compose --env-file infra.env -f docker-compose.infra.yml up -d
# Values marked SECRET must not appear in logs, tickets or chat. Generate each with: openssl rand -base64 36

# --- PostgreSQL (one server, two databases: signalchat_main and signalchat_stage) ---
# SECRET. The superuser: it can log in from inside the container only (docker exec), never over the network.
POSTGRES_PASSWORD=
# SECRET. Login "signalchat_main" on database signalchat_main. Put the same value in main.env.
MAIN_DB_PASSWORD=
# SECRET. Login "signalchat_stage" on database signalchat_stage. Put the same value in stage.env.
STAGE_DB_PASSWORD=
# Host name written into the self-signed TLS certificate, and the public port of the database.
DB_PUBLIC_HOST=chat-db.vlados.tech
POSTGRES_PUBLIC_PORT=5432

# --- Watchtower ---
# Absolute path on the server to the JSON file made by `docker login ghcr.io` (usually ~/.docker/config.json).
REGISTRY_CONFIG_FILE=
# How often Watchtower looks for new images, in seconds.
WATCHTOWER_POLL_INTERVAL_SECONDS=120
