# Copy to .env (git-ignored). Never put secrets in VITE_* variables: they end up in the browser bundle.

# Backend HTTPS URL for the Vite dev proxy (/api, /auth, /hubs).
BACKEND_URL=https://localhost:5001

# `npm run dev` talks to the real backend by default. Set to true to run on the in-memory mocks.
VITE_USE_MOCK_API=false

# Origin of the API when it is not the SPA's own (deployed builds only, set as a Docker build argument).
# Leave empty in development: the Vite proxy makes the API same-origin.
# VITE_API_ORIGIN=https://chat-api.vlados.tech
